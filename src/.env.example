# Environment Configuration for CrimeVision AI
# -----------------------------------------------
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=0
# Optional. If blank, a fresh random key is generated for this local run.
SECRET_KEY=
PORT=5000

# Optional comma-separated list. Defaults to localhost origins on PORT.
CORS_ORIGINS=

# ── Groq LLM API ──────────────────────────────────────────────────────────────
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Upload Limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=200
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,bmp,tiff,webp
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a,ogg,flac,aac
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,mkv,webm

# ── Model Settings ────────────────────────────────────────────────────────────
# RT-DETR model variant (CPU-friendly)
RTDETR_MODEL=PekingU/rtdetr_r18vd

# Whisper model size: tiny | base | small | medium | large
# For 8-16 GB RAM on CPU, "base" or "small" is recommended.
WHISPER_MODEL=base

# Neural weights are local-only by default. Set to 1 only after explicitly
# approving a model download; first-use downloads can be large.
ALLOW_MODEL_DOWNLOADS=0

# BLIP captioning model
BLIP_MODEL=Salesforce/blip-image-captioning-base

# ── Video Processing ──────────────────────────────────────────────────────────
# Analyze one frame every N seconds (lower = more detail, more RAM)
VIDEO_FRAME_INTERVAL_SEC=2
# Maximum number of frames to analyze per video
VIDEO_MAX_FRAMES=60
# Reject videos whose decoded frame dimensions exceed this pixel count
VIDEO_MAX_FRAME_PIXELS=40000000

# ── Data Directories (relative to project root) ───────────────────────────────
UPLOAD_FOLDER=uploads
REPORTS_FOLDER=reports
DATA_FOLDER=data

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to 1 to enable, 0 to disable optional heavy features
ENABLE_BLIP=1
ENABLE_CLIP=1
ENABLE_SPEAKER_DIARIZATION=0
